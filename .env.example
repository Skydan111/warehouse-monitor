# Vorlage für die lokale Datei .env (wird NICHT versioniert).
#
# Normalfall: Nicht von Hand ausfüllen, sondern auf dem Leitstand erzeugen:
#   ./scripts/mqtt_provision.sh <IP des Leitstands>
# Das Skript schreibt .env (Leitstand) und .env.zone-01 (für den Zonensensor).
#
# Werte nie in Chat, Tickets, Logs oder Commits kopieren. Rechte: chmod 600 .env

# Geräteschlüssel (HMAC-SHA256), genau 64 Hex-Zeichen = 32 Byte.
# Auf Zonensensor und Leitstand identisch.
SENSOR_SECRET_HEX=

# Anmeldung am MQTT-Broker
# Leitstand: control_center   Zonensensor: zone-01
MQTT_USERNAME=
MQTT_PASSWORD=

# Nur Zonensensor: Adresse des Leitstands (Broker)
MQTT_BROKER_HOST=
