# Vorlage für die lokale Datei .env (wird NICHT versioniert).
#
#   cp .env.example .env
#   chmod 600 .env
#
# Werte nie in Chat, Tickets, Logs oder Commits kopieren.

# Geräteschlüssel (HMAC-SHA256), genau 64 Hex-Zeichen = 32 Byte.
# Auf Zonensensor und Leitstand identisch.
# Erzeugen und direkt eintragen, ohne ihn anzuzeigen:
#   python3 -c 'import secrets; print("SENSOR_SECRET_HEX=" + secrets.token_hex(32))' >> .env
SENSOR_SECRET_HEX=
